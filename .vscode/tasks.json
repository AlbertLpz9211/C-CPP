{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configurar",
            "type": "shell",
            "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "Genera build/ con Ninja y compile_commands.json"
        },
        {
            "label": "CMake: compilar todo",
            "type": "shell",
            "command": "cmake --build build --parallel",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true },
            "detail": "Compila todos los targets de src/ (build por defecto)"
        },
        {
            "label": "CMake: limpiar",
            "type": "shell",
            "command": "rm -rf build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "Borra build/ por completo"
        },
        {
            "label": "Preparar build/quick",
            "type": "shell",
            "command": "mkdir -p build/quick",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "never", "close": true },
            "detail": "Crea la carpeta de salida de las compilaciones de un solo archivo"
        },
        {
            "label": "C/C++: clang++ compilar archivo activo",
            "type": "cppbuild",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-I",
                "${workspaceFolder}/include",
                "${file}",
                "-o",
                "${workspaceFolder}/build/quick/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Preparar build/quick",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true },
            "detail": "Boton Run/Debug C/C++ File para archivos .cpp"
        },
        {
            "label": "C/C++: clang compilar archivo activo",
            "type": "cppbuild",
            "command": "/usr/bin/clang",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-I",
                "${workspaceFolder}/include",
                "${file}",
                "-o",
                "${workspaceFolder}/build/quick/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Preparar build/quick",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true },
            "detail": "Boton Run/Debug C/C++ File para archivos .c"
        },
        {
            "label": "Compilar archivo actual",
            "type": "shell",
            "command": "mkdir -p build/quick && if [ \"${fileExtname}\" = \".c\" ]; then clang -std=c17 -Wall -Wextra -Wpedantic -g -fcolor-diagnostics -I include \"${file}\" -o \"build/quick/${fileBasenameNoExtension}\"; else clang++ -std=c++20 -Wall -Wextra -Wpedantic -g -fcolor-diagnostics -I include \"${file}\" -o \"build/quick/${fileBasenameNoExtension}\"; fi",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true },
            "detail": "Elige clang o clang++ segun la extension, sale en build/quick/"
        },
        {
            "label": "Ejecutar archivo actual",
            "type": "shell",
            "command": "./build/quick/${fileBasenameNoExtension}",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "dependsOn": "Compilar archivo actual",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "detail": "Compila y ejecuta el archivo abierto en la terminal integrada"
        }
    ]
}
